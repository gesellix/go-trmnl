# Environment for the scrape jobs in victoriametrics/conf.d/, referenced there
# as %{VAR_NAME}. Copy to scrape.env. Kept apart from .env so scrape
# credentials are not handed to every container in the stack.

# go-trmnl (templates/trmnl). host:port of the trmnld server, no scheme.
#TRMNL_TARGET=192.168.1.10:8080
#TRMNL_METRICS_USER=metrics
#TRMNL_METRICS_PASSWORD=change-me
