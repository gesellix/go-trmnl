# Copy to .env and adjust. Compose reads .env automatically.

# Optional services. "dashboards" adds Grafana; drop it on a host with little
# memory (see README.md, "Small hosts") and use http://<host>:8428/vmui.
# Add "ntfy" to run your own ntfy server instead of using ntfy.sh:
# COMPOSE_PROFILES=dashboards,ntfy
COMPOSE_PROFILES=dashboards

# Timezone for logs and Grafana.
TZ=Europe/Berlin

# How long metrics are kept. Months (e.g. 12), or 1y / 3y. A stack with a few
# devices writes well under a gigabyte a year; see README.md ("Footprint").
VM_RETENTION=12

# Share of system memory VictoriaMetrics may use for caches. 30% suits a Pi
# that also runs other things; raise it on a dedicated box.
VM_MEMORY_PERCENT=30

# Address the internal services bind to. 127.0.0.1 keeps VictoriaMetrics,
# vmalert and Alertmanager reachable only from the host itself; use 0.0.0.0 to
# open their web UIs to your LAN.
VM_ADDR=127.0.0.1

# Grafana is the one UI you normally want on the LAN. Only used with the
# "dashboards" profile.
GRAFANA_ADDR=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Links inside alert notifications point here, so use the address you reach the
# host under, not localhost.
VMALERT_EXTERNAL_URL=http://nas.local:8880
ALERTMANAGER_EXTERNAL_URL=http://nas.local:9093

# How often rules are evaluated.
VMALERT_INTERVAL=1m

# Self-hosted ntfy ("ntfy" profile only). NTFY_BASE_URL must be the address
# phones reach the server under, otherwise the app rejects it.
NTFY_ADDR=0.0.0.0
NTFY_PORT=8090
NTFY_BASE_URL=http://nas.local:8090
NTFY_CACHE_DURATION=24h
# iOS needs a relay through ntfy.sh for instant push (a wake-up only, not the
# message). Leave unset on Android.
#NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
