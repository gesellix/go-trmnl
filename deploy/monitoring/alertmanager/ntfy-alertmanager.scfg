# Bridge between Alertmanager and ntfy (scfg format).
# Docs: https://codeberg.org/xenrox/ntfy-alertmanager

http-address :8080
log-level info

# One notification per alert rather than one per Alertmanager group.
alert-mode single

ntfy {
    # Public server by default. To use the stack's own ntfy instead, add "ntfy"
    # to COMPOSE_PROFILES in .env and point this at the container:
    #   server http://ntfy
    server https://ntfy.sh

    # CHANGE THIS. On the public server the topic is the only thing protecting
    # your notifications: anyone who knows the name can read and post to it.
    # Pick something long and random, then subscribe to it in the ntfy app.
    # A topic is a bare name: no host, no slashes, at most 64 characters.
    # ntfy answers 404 otherwise, and the bridge logs "Failed to publish".
    topic go-trmnl-CHANGE-ME-8f3a1c

    markdown true
}

labels {
    order "severity"

    severity "critical" {
        priority 5
        tags "rotating_light"
    }

    severity "warning" {
        priority 3
        tags "warning"
    }
}

resolved {
    tags "white_check_mark"
    priority 1
}

# Suppresses repeats of an alert that is already on your phone.
cache {
    type memory
    duration 24h
}
