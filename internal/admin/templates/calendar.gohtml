{{define "content"}}
<h1>Calendar accounts</h1>

<h2>Google OAuth clients</h2>
<p class="muted">Create an OAuth client in your
<a href="https://console.cloud.google.com/">Google Cloud project</a> (Calendar
API enabled, type "Web application") and register this redirect URI:
<code>{{.RedirectURI}}</code>. You can add more than one client (e.g. one per
project).</p>

{{if .OAuthClients}}
<table class="list">
  <thead><tr><th>Name</th><th>Client ID</th><th></th></tr></thead>
  <tbody>
  {{range .OAuthClients}}
    <tr>
      <td>{{.Name}}</td>
      <td><span class="muted">{{.ClientID}}</span></td>
      <td><form method="post" action="/admin/calendar/oauth-clients/{{.ID}}/delete" class="inline" onsubmit="return confirm('Delete this OAuth client?')"><button type="submit" class="danger">Delete</button></form></td>
    </tr>
  {{end}}
  </tbody>
</table>
{{end}}

<form method="post" action="/admin/calendar/oauth-clients">
  <label>Name <input type="text" name="name" placeholder="e.g. Family GCP project"></label>
  <label>Client ID <input type="text" name="client_id" autocomplete="off"></label>
  <label>Client secret <input type="password" name="client_secret" autocomplete="off"></label>
  <button type="submit">Add OAuth client</button>
</form>

<h2>Add account</h2>
{{if .OAuthClients}}
<form method="get" action="/admin/calendar/google/start" class="inline">
  <label>Google account via
    <select name="client">
      {{range .OAuthClients}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
    </select>
  </label>
  <button type="submit">Add Google account</button>
</form>
{{else}}
<p class="muted">Add a Google OAuth client above to connect Google accounts.</p>
{{end}}

<form method="post" action="/admin/calendar/caldav">
  <h3>Apple iCloud / CalDAV</h3>
  <p class="muted">For iCloud, use your Apple ID and an
  <a href="https://support.apple.com/en-us/102654">app-specific password</a>.</p>
  <label>Name <input type="text" name="name" placeholder="e.g. Dad (iCloud)"></label>
  <label>Marker <input type="text" name="marker" maxlength="2" size="3"></label>
  <label>Apple ID / username <input type="text" name="username" autocomplete="off"></label>
  <label>App-specific password <input type="password" name="password" autocomplete="off"></label>
  <label>Server <input type="text" name="endpoint" value="{{.DefaultCalDAVEndpoint}}"></label>
  <label>Refresh every (hours) <input type="number" name="refresh_hours" value="12" min="1" step="1"></label>
  <button type="submit">Add CalDAV account</button>
</form>

{{if .Accounts}}
<table class="list">
  <thead><tr><th>Name</th><th>Provider</th><th>Marker</th><th>Refresh</th><th>Last sync</th><th></th></tr></thead>
  <tbody>
  {{range .Accounts}}
    <tr>
      <td><a href="/admin/calendar/{{.ID}}">{{.Name}}</a>{{if .Error}}<br><span class="muted">error: {{.Error}}</span>{{end}}</td>
      <td>{{.Provider}}</td>
      <td>{{.Marker}}</td>
      <td>{{.Refresh}}</td>
      <td>{{.LastSync}}</td>
      <td>
        <form method="post" action="/admin/calendar/{{.ID}}/sync" class="inline"><button type="submit">Sync now</button></form>
        <form method="post" action="/admin/calendar/{{.ID}}/delete" class="inline" onsubmit="return confirm('Remove this account?')"><button type="submit" class="danger">Delete</button></form>
      </td>
    </tr>
  {{end}}
  </tbody>
</table>
{{else}}
<p class="muted">No calendar accounts yet.</p>
{{end}}
{{end}}
