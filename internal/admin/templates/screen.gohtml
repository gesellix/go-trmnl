{{define "content"}}
{{$s := .Screen}}
<p><a href="/admin/screens">&larr; Screens</a></p>
<h1>{{$s.Name}} <span class="muted">({{.PluginType}})</span></h1>

<div class="split">
  <div>
    <h2>Settings</h2>
    <form method="post" action="/admin/screens/{{$s.ID}}">
      <label>Name <input type="text" name="name" value="{{$s.Name}}"></label>
      <label>Dithering mode
        <select name="dither_mode">
          <option value="" {{if eq .DitherMode ""}}selected{{end}}>Default (global: {{.GlobalDither}})</option>
          <option value="floyd_steinberg" {{if eq .DitherMode "floyd_steinberg"}}selected{{end}}>Floyd-Steinberg (best for photos)</option>
          <option value="threshold" {{if eq .DitherMode "threshold"}}selected{{end}}>Threshold (sharp, for text/UI)</option>
        </select>
      </label>
      {{if .IsFamilyCalendar}}
      <p>Calendar accounts to show <span class="muted">(none selected = all)</span></p>
      {{range .FCAccounts}}
      <label class="check"><input type="checkbox" name="accounts" value="{{.ID}}" {{if .Selected}}checked{{end}}> {{.Name}} <span class="muted">({{.Provider}}{{if .Marker}}, {{.Marker}}{{end}})</span></label>
      {{else}}
      <p class="muted">No calendar accounts yet — add them under <a href="/admin/calendar">Calendar</a>.</p>
      {{end}}
      <label>Days ahead <input type="number" name="days" value="{{.FCDays}}" min="1" step="1"></label>
      <label>Max events <input type="number" name="max_events" value="{{.FCMaxEvents}}" min="1" step="1"></label>
      <label>Label <input type="text" name="label" value="{{.FCLabel}}"></label>
      <label class="check"><input type="checkbox" name="use_24h" {{if .FCUse24h}}checked{{end}}> 24-hour times</label>
      {{else}}
      <label>Settings (JSON)
        <textarea name="settings_json" rows="10">{{$s.SettingsJSON}}</textarea>
      </label>
      {{end}}
      <button type="submit">Save</button>
    </form>

    {{if .IsImage}}
    <h2>Upload image</h2>
    <form method="post" action="/admin/screens/{{$s.ID}}/upload" enctype="multipart/form-data">
      <input type="file" name="image" accept="image/*">
      <button type="submit">Upload</button>
    </form>
    {{end}}
  </div>
  <div>
    <h2>Preview</h2>
    {{if $s.RenderedHash.Valid}}
      <img class="preview" src="{{.BaseURL}}/uploads/{{ns $s.RenderedHash}}.png" alt="preview">
    {{else}}
      <p class="muted">Not rendered yet.</p>
    {{end}}
    <form method="post" action="/admin/screens/{{$s.ID}}/preview">
      <button type="submit">Render preview</button>
    </form>
  </div>
</div>

<form method="post" action="/admin/screens/{{$s.ID}}/delete" onsubmit="return confirm('Delete this screen?')">
  <button type="submit" class="danger">Delete screen</button>
</form>
{{end}}
