<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>go-trmnl admin</title>
  <link rel="stylesheet" href="/admin/static/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/admin">go-trmnl</a>
    <nav>
      <a href="/admin" class="{{if eq .Nav "dashboard"}}active{{end}}">Dashboard</a>
      <a href="/admin/devices" class="{{if eq .Nav "devices"}}active{{end}}">Devices</a>
      <a href="/admin/screens" class="{{if eq .Nav "screens"}}active{{end}}">Screens</a>
      <a href="/admin/playlists" class="{{if eq .Nav "playlists"}}active{{end}}">Playlists</a>
      <a href="/admin/calendar" class="{{if eq .Nav "calendar"}}active{{end}}">Calendar</a>
      <a href="/admin/settings" class="{{if eq .Nav "settings"}}active{{end}}">Settings</a>
    </nav>
  </header>
  <main>
    {{block "content" .}}{{end}}
  </main>
</body>
</html>
